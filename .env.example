# Railway Postgres connection (required)
DATABASE_URL=postgresql://user:password@host:5432/database

# Public site URL used to generate flyer QR codes
NEXT_PUBLIC_SITE_URL=https://alookatalog.up.railway.app

# Railway / server networking
HOSTNAME=0.0.0.0

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional contact
SUPPORT_PHONE=+998000000000
